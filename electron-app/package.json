{
  "private": true,
  "name": "elf-desk",
  "productName": "Elf Desk",
  "version": "0.1.0",
  "main": "lib/backend/electron-main.js",
  "license": "Apache-2.0",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Elf Desk",
        "reloadOnReconnect": true,
        "preferences": {
          "files.enableTrash": false
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "configurationFolder": ".elf-desk-ide"
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/electron": "1.77.0",
    "@theia/file-search": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/keymaps": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/outline-view": "1.77.0",
    "@theia/plugin-ext": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/process": "1.77.0",
    "@theia/scm": "1.77.0",
    "@theia/search-in-workspace": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0",
    "elf-desk-extension": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0",
    "electron": "44.9.1",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "bundle": "theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start",
    "package": "npm run bundle:production && electron-builder --publish never",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false",
    "bundle:production": "theia build --mode production"
  },
  "theiaPluginsDir": "../plugins",
  "theiaPlugins": {
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix"
  },
  "description": "The Elf Desk as a desktop app, built on Eclipse Theia",
  "author": "Phillip Kr\u00fcger",
  "homepage": "https://github.com/House-elves/elf-desk-ide"
}
