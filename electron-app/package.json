{
  "private": true,
  "name": "electron-app",
  "productName": "Elf Desk",
  "version": "0.1.0",
  "main": "lib/backend/electron-main.js",
  "license": "Apache-2.0",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Elf Desk",
        "reloadOnReconnect": true,
        "preferences": {
          "files.enableTrash": false
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/electron": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/process": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0",
    "@theia/search-in-workspace": "1.77.0",
    "@theia/file-search": "1.77.0",
    "@theia/keymaps": "1.77.0",
    "@theia/outline-view": "1.77.0",
    "elf-desk-extension": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0",
    "electron": "44.9.1",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "bundle": "theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start",
    "package": "electron-builder"
  }
}
