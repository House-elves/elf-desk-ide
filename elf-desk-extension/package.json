{
  "name": "elf-desk-extension",
  "version": "0.1.0",
  "description": "The Elf Desk inside Theia: the desk as a panel, and sessions opened as the workspace",
  "license": "Apache-2.0",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/core": "1.77.0",
    "@theia/workspace": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/electron": "1.77.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "rimraf": "^5.0.0"
  },
  "scripts": {
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "frontendElectron": "lib/browser/elf-desk-frontend-module",
      "electronMain": "lib/electron-main/elf-desk-main-module"
    }
  ],
  "type": "module"
}
